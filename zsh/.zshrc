# ~/.zshrc (linked from hypr-dotfiles/zsh by install.sh)

ZSH_PLUGINS="${XDG_DATA_HOME:-$HOME/.local/share}/zsh/plugins"
mkdir -p "${XDG_STATE_HOME:-$HOME/.local/state}/zsh" "${XDG_CACHE_HOME:-$HOME/.cache}/zsh"

# History
HISTFILE="${XDG_STATE_HOME:-$HOME/.local/state}/zsh/history"
HISTSIZE=10000
SAVEHIST=10000
setopt share_history hist_ignore_all_dups hist_ignore_space
setopt autocd interactive_comments
bindkey -e

# Completion
autoload -Uz compinit
compinit -d "${XDG_CACHE_HOME:-$HOME/.cache}/zsh/zcompdump"
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Z}'
zstyle ':completion:*' list-colors ${(s.:.)LS_COLORS}
zstyle ':completion:*' menu no                    # fzf-tab draws the menu
zstyle ':fzf-tab:*' use-fzf-default-opts yes      # use the matugen colors below

# Prompt: starship (config generated by matugen, see matugen/templates/starship.toml).
# Fallback until starship is installed: directory, git branch, ❯ (red after a failure).
if (( $+commands[starship] )); then
  eval "$(starship init zsh)"
else
  autoload -Uz vcs_info
  precmd() { vcs_info }
  zstyle ':vcs_info:git:*' formats ' %F{magenta}%b%f'
  setopt prompt_subst
  PROMPT='%F{blue}%~%f${vcs_info_msg_0_} %(?.%F{green}.%F{red})❯%f '
fi

# Aliases
alias ls='ls --color=auto'
alias grep='grep --color=auto'

# fzf: Ctrl+R history, Ctrl+T files, Alt+C cd
(( $+commands[fzf] )) && source <(fzf --zsh)

# Plugins: fzf-tab after compinit, syntax highlighting last
[[ -f $ZSH_PLUGINS/fzf-tab/fzf-tab.plugin.zsh ]] && source "$ZSH_PLUGINS/fzf-tab/fzf-tab.plugin.zsh"
[[ -f /usr/share/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ]] \
  && source /usr/share/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh

# fzf and highlighting colors (palette indexes that follow the wallpaper)
source "${${(%):-%x}:A:h}/colors.zsh"
