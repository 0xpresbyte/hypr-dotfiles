{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  // Colors are ANSI names, so they follow the matugen palette set in Ghostty.
  "logo": {
    "source": "arch",
    "color": { "1": "blue", "2": "blue" },
    "padding": { "left": 1, "right": 3 }
  },
  "display": {
    "separator": " ",
    "color": { "keys": "blue", "title": "magenta" },
    "key": { "width": 11 }
  },
  "modules": [
    { "type": "title", "format": "{user-name}@{host-name}" },

    { "type": "custom", "format": "{#90}╭─ {#35}software {#90}──────────────────────────────" },
    { "type": "os", "key": "{#90}│{#34} os", "format": "{name}" },
    { "type": "kernel", "key": "{#90}│{#34} kernel", "format": "{release}" },
    { "type": "uptime", "key": "{#90}│{#34} uptime" },
    { "type": "packages", "key": "{#90}│{#34} pkgs" },
    { "type": "wm", "key": "{#90}│{#34} wm", "format": "{pretty-name}" },
    { "type": "shell", "key": "{#90}│{#34} shell", "format": "{pretty-name}" },
    { "type": "terminal", "key": "{#90}│{#34} term", "format": "{pretty-name}" },
    { "type": "custom", "format": "{#90}╰─────────────────────────────────────────" },

    { "type": "custom", "format": "{#90}╭─ {#35}hardware {#90}──────────────────────────────" },
    { "type": "host", "key": "{#90}│{#34} host", "format": "{name}" },
    { "type": "cpu", "key": "{#90}│{#34} cpu", "format": "{name} ({cores-logical}) @ {freq-max}" },
    { "type": "gpu", "key": "{#90}│{#34} gpu", "format": "{vendor} {name} ({type})" },
    { "type": "memory", "key": "{#90}│{#34} mem", "format": "{used} / {total}" },
    { "type": "disk", "key": "{#90}│{#34} disk", "folders": "/", "format": "{size-used} / {size-total}" },
    { "type": "display", "key": "{#90}│{#34} display", "format": "{width}x{height} @ {refresh-rate} Hz" },
    { "type": "battery", "key": "{#90}│{#34} battery", "format": "{capacity} ({status})" },
    { "type": "custom", "format": "{#90}╰─────────────────────────────────────────" },

    { "type": "colors", "symbol": "circle" }
  ]
}
